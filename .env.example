# ============================================
# VYBZZZ ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================

# --------------------------------------------
# SUPABASE (https://supabase.com/dashboard)
# Go to Settings > API to find these values
# --------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (BACKEND ONLY - never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------
# STRIPE (https://dashboard.stripe.com/apikeys)
# Use test keys for development, live keys for production
# --------------------------------------------
# Publishable key (safe for client)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret key (BACKEND ONLY - never expose to client!)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price IDs (create these in Stripe Dashboard > Products)
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_FOUNDER=price_xxx

# --------------------------------------------
# MUX (https://dashboard.mux.com)
# Go to Settings > API Access Tokens
# --------------------------------------------
EXPO_PUBLIC_MUX_ENV_KEY=your_mux_environment_key

# API Credentials (BACKEND ONLY)
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Webhook signing secret
MUX_WEBHOOK_SECRET=your_mux_webhook_secret

# --------------------------------------------
# API CONFIGURATION
# --------------------------------------------
# Backend API URL (your deployed API)
EXPO_PUBLIC_RORK_API_BASE_URL=https://your-api.vercel.app

# Development
# EXPO_PUBLIC_RORK_API_BASE_URL=http://localhost:3000

# --------------------------------------------
# APP CONFIGURATION
# --------------------------------------------
EXPO_PUBLIC_APP_ENV=development
# Options: development, staging, production

# --------------------------------------------
# SECURITY
# --------------------------------------------
# Secret for QR code generation (use a random string)
QR_SECRET=your_random_secret_string_here

# --------------------------------------------
# FEATURE FLAGS
# --------------------------------------------
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASHLYTICS=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false

# --------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# --------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# MIXPANEL_TOKEN=xxx
# AMPLITUDE_API_KEY=xxx
